# Gemini API Key for Narrative Prescriptions
GEMINI_API_KEY=

# Square API Integration (Live Production Mode)
# Obtain from Square Developer Dashboard (https://developer.squareup.com/apps)
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=production

# Resend API for Sanctuary Contact Inquiries
# Obtain from Resend Dashboard (https://resend.com/api-keys)
RESEND_API_KEY=
# Optional: Sender email (Defaults to "Haus of Zen <onboarding@resend.dev>" or your verified domain e.g. "Haus of Zen <contact@myhausofzen.com>")
RESEND_FROM_EMAIL=
# Optional: Destination inbox (Defaults to "info@myhausofzen.com")
RESEND_TO_EMAIL=
